<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <!-- upload-artifact zips the exe, so the root element is a zip-file. -->
  <zip-file>
    <pe-file path="WinBloatFree.exe" product-name="WinBloatFree" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
