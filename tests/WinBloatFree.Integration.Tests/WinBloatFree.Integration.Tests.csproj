<Project Sdk="Microsoft.NET.Sdk">
  <!-- Real-Windows checks, run on a Windows agent: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WinBloatFree.Integration.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WinBloatFree.Core\WinBloatFree.Core.csproj" />
    <Compile Include="..\..\src\WinBloatFree\Platform\*.cs" Link="Platform\%(Filename).cs" />
  </ItemGroup>
</Project>
