    {
      "id": "ads.explorer",
      "name": "Turn off File Explorer ads",
      "summary": "No more OneDrive and Microsoft 365 promotions in File Explorer.",
      "description": "Turns off sync provider notifications, which Windows uses to show OneDrive and Microsoft 365 offers in File Explorer.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "ShowSyncProviderNotifications",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.bing",
      "name": "Turn off Bing in Start search",
      "summary": "Start search shows only results from your PC.",
      "description": "Stops Start search from sending what you type to Bing and from showing web results. Searching for apps, files and settings works as before.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "restart": true,
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Policies\\Microsoft\\Windows\\Explorer",
          "name": "DisableSearchBoxSuggestions",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Search",
          "name": "BingSearchEnabled",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.search-highlights",
      "name": "Turn off search highlights",
      "summary": "Removes the daily pictures and trending searches in the search box.",
      "description": "Turns off search highlights, the changing illustrations and trending content in the search box and search home.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
          "name": "IsDynamicSearchBoxEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search",
          "name": "EnableDynamicContentInWSB",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.widgets",
      "name": "Turn off Widgets and news",
      "summary": "Removes the Widgets board and its news feed from the taskbar.",
      "description": "Turns off Widgets with its news feed on Windows 11 and News and interests on Windows 10, by policy for every user.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "restart": true,
      "goodToKnow": "On some Windows 11 versions, Windows blocks apps from changing this policy. If Apply cannot change it, turn Widgets off in Settings > Personalization > Taskbar.",
      "actions": [
        {
          "type": "Registry",
          "hive": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Dsh",
          "name": "AllowNewsAndInterests",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Feeds",
          "name": "EnableFeeds",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.suggested-apps",
      "name": "Stop automatic installs of suggested apps",
      "summary": "Windows stops installing promoted apps on its own.",
      "description": "Stops Windows from silently installing suggested apps and games and turns off the consumer experience that adds them. Apps already installed stay. Remove them under Bloatware Apps.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "goodToKnow": "The consumer experience policy is only fully honored on Enterprise and Education. The other values work on Home and Pro.",
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SilentInstalledAppsEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "PreInstalledAppsEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "OemPreInstalledAppsEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
          "name": "DisableWindowsConsumerFeatures",
          "kind": "DWord",
          "value": 1
        }
      ]
    },
    {
      "id": "ads.notifications",
      "name": "Turn off suggestion notifications",
      "summary": "No more notifications suggesting ways to use Windows.",
      "description": "Turns off the Suggested notifications that Windows sends to promote features and settings.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings\\Windows.SystemToast.Suggested",
          "name": "Enabled",
          "kind": "DWord",
          "value": 0
        }
      ]
    }
  ]
}
