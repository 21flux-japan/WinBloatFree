{
  "id": "ads",
  "name": "Ads & Suggestions",
  "description": "Removes ads, promotions and suggestions from Start, the lock screen, Settings, File Explorer and search.",
  "icon": "E8BD",
  "kind": "list",
  "order": 6,
  "tweaks": [
    {
      "id": "ads.start",
      "name": "Turn off Start menu suggestions",
      "summary": "No more suggested apps and tips in Start.",
      "description": "Turns off app suggestions in Start, recommendations for tips, shortcuts and new apps, and account notifications in Start.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SystemPaneSuggestionsEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338388Enabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "Start_IrisRecommendations",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "Start_AccountNotifications",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.lock-screen",
      "name": "Turn off lock screen tips and fun facts",
      "summary": "Removes tips, tricks and ads from the lock screen.",
      "description": "Turns off fun facts, tips and tricks on the lock screen. Your lock screen picture, including Windows Spotlight, stays as it is.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "RotatingLockScreenOverlayEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338387Enabled",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.settings",
      "name": "Turn off suggestions in Settings",
      "summary": "No more suggested content in the Settings app.",
      "description": "Turns off the suggested content and promotions that Settings shows on some pages.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
