        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-353694Enabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-353696Enabled",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "ads.tips",
      "name": "Turn off Windows tips and setup prompts",
      "summary": "Stops \"Get even more out of Windows\" and welcome screens.",
      "description": "Turns off tips and suggestions while you use Windows, the welcome experience after updates, and the \"Finish setting up your device\" screen.",
      "risk": "Safe",
      "presets": [
        "recommended",
        "privacy",
        "everything"
      ],
      "actions": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338389Enabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SoftLandingEnabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-310093Enabled",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement",
          "name": "ScoobeSystemSettingEnabled",
          "kind": "DWord",
          "value": 0
