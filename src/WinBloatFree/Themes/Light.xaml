<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generated from the approved mockup colors. Keep the same keys in Dark.xaml and Light.xaml. -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF0F8" Offset="0" />
        <GradientStop Color="#F3F3F3" Offset="0.45" />
        <GradientStop Color="#F3F0F6" Offset="1" />
    </LinearGradientBrush>
