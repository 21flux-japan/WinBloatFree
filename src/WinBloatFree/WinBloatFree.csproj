<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 19041 Windows SDK target gives the in-box PackageManager API for app removal. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WinBloatFree</RootNamespace>
    <AssemblyName>WinBloatFree</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.2</Version>
    <Product>WinBloatFree</Product>
    <Company>21 FLUX</Company>
    <Copyright>Copyright (c) 2026 Michael (21 FLUX). MIT License.</Copyright>
    <Description>Portable tool to turn off telemetry, ads and bloat in Windows 10 and 11.</Description>

    <!-- Portable single exe: no installer, no runtime needed on the PC. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF does not support trimming, so size is kept down in safe ways only. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Turn off runtime features that are not needed. Nothing here phones home either way. -->
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinBloatFree.Core\WinBloatFree.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.png" />
  </ItemGroup>
</Project>
